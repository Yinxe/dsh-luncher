{
  "name": "dsh-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform launcher for @deepseek-ai/dsh",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "tauri icon src-tauri/icons/app-icon.png",
    "app": "tauri dev",
    "build:debug": "npm run build && cd src-tauri && PKG_CONFIG_PATH=\"$PWD/.sysroot/usr/lib/x86_64-linux-gnu/pkgconfig:$PWD/.sysroot/usr/share/pkgconfig\" RUSTFLAGS=\"-L native=$PWD/.sysroot/usr/lib/x86_64-linux-gnu\" cargo build",
    "build:release": "npm run build && cd src-tauri && PKG_CONFIG_PATH=\"$PWD/.sysroot/usr/lib/x86_64-linux-gnu/pkgconfig:$PWD/.sysroot/usr/share/pkgconfig\" RUSTFLAGS=\"-L native=$PWD/.sysroot/usr/lib/x86_64-linux-gnu\" cargo build --release --features custom-protocol",
    "start": "cd src-tauri && ([ -x target/release/dsh-launcher ] || (cd .. && npm run build:release)) && LD_LIBRARY_PATH=\"$PWD/.sysroot/usr/lib/x86_64-linux-gnu\" ./target/release/dsh-launcher",
    "release": "npm run build:release"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
